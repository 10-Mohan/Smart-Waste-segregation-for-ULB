# Server Port
PORT=5000

# Authentication (Must be set to a long random secret in production)
JWT_SECRET=replace-with-a-long-random-secret

# Database Configuration
# Dialect: sqlite (default for local dev) or postgres (hosted cloud DB e.g. Neon, Supabase, RDS)
DB_DIALECT=sqlite
DATABASE_URL=./data/dev.sqlite
# Set DB_SSL=false only if connecting to a local/non-SSL PostgreSQL instance. Defaults to true for postgres.
DB_SSL=true

# Environment
NODE_ENV=development

# CORS (Defaults to http://localhost:5173 for local dev; not needed for same-origin on Vercel)
# CORS_ORIGIN=http://localhost:5173

# SMS Notification Provider (console by default for dev/testing, fast2sms for production)
SMS_PROVIDER=console
FAST2SMS_API_KEY=

# Seeding & Safety
# Optional override for demo credentials password (defaults to Demo@1234)
DEMO_PASSWORD=Demo@1234
# Required to execute destructive reset (`npm run seed -- --reset`) on PostgreSQL / remote databases
ALLOW_DB_RESET=false

# Rate Limit settings (defaults to 5 registrations/hr, 30 status/15min in production)
REGISTER_RATE_LIMIT_MAX=100
REGISTER_RATE_LIMIT_WINDOW_MINUTES=60
CITIZEN_STATUS_RATE_LIMIT_MAX=500
CITIZEN_STATUS_RATE_LIMIT_WINDOW_MINUTES=15